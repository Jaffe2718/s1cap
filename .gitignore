# Node / TypeScript
node_modules/
dist/
lib/
build/
*.tsbuildinfo
coverage/
.npm/
.eslintcache

# Python (local S1 runtimes, bench tooling)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Models & data artifacts (download-on-demand, never commit)
*.onnx
*.gguf
*.safetensors
models/
# The whole local data directory: checkpoint caches, launch logs, and the tuning file the panel writes.
# Ignoring extensions was not enough for a Hugging Face cache: its layout is `config.json`, `rl_agent_config.json`
# and one tokenizer file of tens of megabytes, none of which match the rules above, so the first real backend start
# committed 252,198 lines of downloaded weights. The rule that survives the next cache layout is the directory.
/.s1cap/

# Telemetry & experiment outputs
telemetry/
bench/runs/
bench/results/
*.sqlite
*.sqlite3
*.jsonl
# Deterministic, synthetic replay inputs are source-controlled test data.
!/packages/core/test/fixtures/*.jsonl
*.log

# Environment & secrets
.env
.env.*
*.local

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
