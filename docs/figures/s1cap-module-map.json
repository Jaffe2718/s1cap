  ],
  "phases": [
    { "id": "phase-selective", "label": "① Selective Context", "fromCol": 0, "toCol": 4, "variant": "emphasis" },
    { "id": "phase-planning", "label": "② Planning", "fromCol": 5, "toCol": 5 }
  ],
  "mainPath": ["x-event", "segrec", "s1assoc", "rg", "assembler", "llm", "s1decide", "plangate", "execute"],
  "nodes": [
    { "id": "x-event", "lane": "harness", "col": 0, "type": "external", "label": "Event Intake" },
    { "id": "segrec", "lane": "control", "col": 0, "type": "backend", "label": "Segment/Recall" },
    { "id": "rg", "lane": "control", "col": 2, "type": "database", "label": "Assoc. Graph" },
    { "id": "assembler", "lane": "control", "col": 4, "type": "backend", "label": "ASSEMBLER" },
    { "id": "llm", "lane": "s2", "col": 4, "type": "cloud", "label": "System-2 LLM" },
    { "id": "plangate", "lane": "control", "col": 5, "type": "backend", "label": "PLAN GATE" },
    { "id": "execute", "lane": "harness", "col": 5, "type": "messagebus", "label": "Run + Verify" },
    { "id": "s1assoc", "lane": "s1", "col": 2, "type": "cloud", "label": "S1 Assoc Backend", "width": 120 },
    { "id": "s1decide", "lane": "s1", "col": 4, "type": "cloud", "label": "S1 Decide Backend", "width": 120 }
  ],
  "edges": [
    { "id": "e1", "from": "x-event", "to": "segrec", "label": "x · tools · traces", "role": "main" },
    { "id": "e2", "from": "segrec", "to": "s1assoc", "label": "new × history segs", "role": "main" },
    { "id": "e3", "from": "rg", "to": "assembler", "label": "BFS(τ,d) + budget", "role": "main" },
    { "id": "e4", "from": "assembler", "to": "llm", "label": "TAS injection", "role": "main", "variant": "emphasis", "labelAt": [500, 305] },
    { "id": "e5", "from": "llm", "to": "s1decide", "label": "candidate plans", "role": "main", "labelAt": [500, 429] },
    { "id": "e7", "from": "plangate", "to": "execute", "label": "probability order", "role": "main", "labelAt": [625, 181] },
    { "id": "e8", "from": "execute", "to": "x-event", "label": "tool results loop back", "role": "return", "variant": "dashed" },
    { "id": "e9", "from": "s1assoc", "to": "rg", "label": "expand RG · weights + decay", "role": "main", "labelAt": [300, 367] },
    { "id": "e10", "from": "s1decide", "to": "plangate", "label": "choice scores", "role": "main" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "Module Roles",
      "items": [
        "Event Intake — user input x, tool results, traces",
        "Segment/Recall — message-level segments + tier-0/1",
        "S1 Assoc Backend — segment × history relevance (noul)",
        "Assoc. Graph — weighted edges, w·exp(−Δt/λ) decay",
        "ASSEMBLER — per LLM call: BFS(τ,d) + budget + TAS",
        "System-2 LLM — governed host model, reads assembled ctx",
        "S1 Decide Backend — plan choice scoring (p, confidence)",
        "PLAN GATE — orders the model's plans, never vetoes stop",
        "Run + Verify — ordered attempts, drop rest on success"
      ]
    },
    {
      "dot": "emerald",
      "title": "Loop · Authority · Async",
      "items": [
        "One user turn = many LLM steps (think · act · tool)",
        "ASSEMBLER runs before every LLM call, not per turn",
        "RG upkeep is silent and async: it may lag behind",
        "Stopping is the model's call; S1CAP cannot veto it",
        "Surface rewrite: model view only; transcript intact",
        "Telemetry JSONL v1: session log + control log, split"
      ]
    }
  ]
}
