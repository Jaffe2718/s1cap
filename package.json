{
  "name": "s1cap",
  "version": "0.1.0",
  "private": true,
  "description": "S1CAP: Context-Aware Planning via System-1 Models for Efficient LLM Agents",
  "author": "Yuanming Chen and LI Changzhe",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build-packages.mjs",
    "test": "node --test --experimental-strip-types \"packages/*/test/*.test.ts\"",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.base.json --noEmit",
    "dsh:add": "dsh plugin --profile web add file:./packages/dsh-plugin"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
