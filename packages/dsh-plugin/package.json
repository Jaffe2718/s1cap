{
  "name": "dsh-s1cap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S1CAP (System-1 Context-Aware Planning) for DeepSeek Harness: which context an LLM agent sees, and in which order its own plans run",
  "author": "Yuanming Chen and LI Changzhe",
  "main": "lib/index.js",
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "supported"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@s1cap/core": "file:../core",
    "@s1cap/laya-runtime": "file:../laya-runtime",
    "@s1cap/s1-client": "file:../s1-client"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
